# Copie este arquivo para tools/audio/.env e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).

# Serviço de voz: google ou elevenlabs
PROVEDOR=google

# --- Google Cloud Text-to-Speech ---
GOOGLE_TTS_API_KEY=cole-a-sua-chave-aqui
# Vozes pt-BR com SSML completo (pausas, títulos mais lentos, capítulos): pt-BR-Neural2-A, pt-BR-Neural2-B, pt-BR-Neural2-C,
# pt-BR-Wavenet-A ... Mais naturais, mas sem pausas finas nem capítulos exatos: pt-BR-Chirp3-HD-Aoede, pt-BR-Chirp3-HD-Charon...
# A lista completa está em https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_VOZ=pt-BR-Neural2-A
# Velocidade da fala no arquivo (1 = normal). No app ainda dá para ouvir em 1.25x e 1.5x.
VELOCIDADE=1

# --- ElevenLabs (para trocar depois: PROVEDOR=elevenlabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2
